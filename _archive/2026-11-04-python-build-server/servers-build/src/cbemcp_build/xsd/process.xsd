    <xs:attribute name="value" default="message">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="message"/>
          <xs:enumeration value="confirm"/>
          <xs:enumeration value="input"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="op_confirm__initial" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_confirm__message" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_confirm__modal" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
