    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_close__mode" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <!-- operation: confirm -->
  <xs:complexType name="op_confirm">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="type" type="op_confirm__type" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="initial" type="op_confirm__initial" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="message" type="op_confirm__message" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="modal" type="op_confirm__modal" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="ok" type="op_confirm__ok" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="cancel" type="op_confirm__cancel" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="title" type="op_confirm__title" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="icon" type="op_confirm__icon" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="height" type="op_confirm__height" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="confirm"/>
  </xs:complexType>
  <xs:complexType name="op_confirm__type">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
