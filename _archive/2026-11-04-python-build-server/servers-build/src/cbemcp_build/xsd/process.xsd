      <xs:element name="logout" type="op__leaf" minOccurs="0" maxOccurs="unbounded">
      <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Logs the current identity out. Instruction of the system operation.</p><pre><code>&lt;operation name="system"&gt;<br/>&#32;&#32;&lt;logout/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="system"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>
  <!-- operation: tenant -->
  <xs:complexType name="op_tenant">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="createUser" type="op_tenant__createUser" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>The createUser operation defines 8 metrics that enables the developer to create a user to the Tenant. Two of which are optional/not requiered for the user to be created.</p>]]></xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="deleteUser" type="op_tenant__deleteUser" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Deleting users is done in two steps: First, call deleteUsers with type equal to requestdelete. This will trigger the cloudbackend system to send out an email to the enduser to verify the delete by clicking a link.</p><pre><code>&lt;operation name="tenant"&gt;<br/>&#32;&#32;&lt;deleteUser type="requestdelete" userid="userId" usedefault="true/false"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="tenant"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_tenant__createUser">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="username" type="xs:string"/>
    <xs:attribute name="password" type="xs:string"/>
    <xs:attribute name="firstname" type="xs:string"/>
    <xs:attribute name="lastname" type="xs:string"/>
    <xs:attribute name="email" type="xs:string"/>
    <xs:attribute name="source" type="xs:string"/>
    <xs:attribute name="responseAlias" type="xs:string"/>
    <xs:attribute name="referralCode" type="xs:string"/>
    <xs:attribute name="eulaVersion" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_tenant__deleteUser">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="code" type="xs:string" use="required"/>
    <xs:attribute name="username" type="xs:string" use="required"/>
    <xs:attribute name="userid" type="xs:string" use="required"/>
    <xs:attribute name="forgetuser" type="xs:string"/>
    <xs:attribute name="deletecontent" type="xs:string"/>
    <xs:attribute name="usedefault" type="xs:string"/>
  </xs:complexType>
  <!-- ============================================================= -->
  <!-- Operation children, declared globally                         -->
  <!-- ============================================================= -->
  <!-- These were a closed xs:choice, which kept reporting valid markup as
       invalid: each operation (tenant, database, groups, config, system, …) has
       its own instruction set, and applications embed their own XML payloads
       besides. The operation content model is now a skipped wildcard, and these
       declarations are global so vscode-xml still offers them — with their
       documentation — at that wildcard.
       Little is given up: validating an operation's children was only ever a
       check on the element name, since their attributes were already unvalidated
       (anyAttribute/skip). `view` is absent because view.xsd already declares a
       global element of that name; the wildcard still accepts it. -->

  <!-- Instructions the reference documents but does not tie to an operation.
       They stay globally declared so the editor still suggests them; everything
       else is declared inside the op_* content model it belongs to, so a
       decision no longer suggests `saveas` and a database call no longer
       suggests `when`. Children of <operation> are matched by an xs:any with
       processContents="skip", and for a wildcard the editor falls back to
       offering every global element — which is why a global is a suggestion in
       every operation at once. -->

  <!-- What the action operation can do to a component. Enumerated so the editor
       offers the set instead of leaving the attribute free text, where the only
       suggestions were the editor's own guesses at words in the document.
       A union, like the operation name below it: an action a newer runtime adds,
       or one this list has missed, still validates rather than turning working
       manifests red. Which actions apply to which component is per component —
       see the "Actions" section of the reference — and is not expressed here. -->
  <xs:simpleType name="t_componentAction">
    <xs:union memberTypes="t_componentActionBuiltIn t_componentActionOther"/>
  </xs:simpleType>

  <xs:simpleType name="t_componentActionOther">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="t_componentActionBuiltIn">
    <xs:restriction base="xs:string">
      <xs:enumeration value="activate"/>
      <xs:enumeration value="add"/>
      <xs:enumeration value="busy"/>
      <xs:enumeration value="clear"/>
      <xs:enumeration value="disable"/>
      <xs:enumeration value="enable"/>
      <xs:enumeration value="error"/>
      <xs:enumeration value="focus"/>
      <xs:enumeration value="hide"/>
      <xs:enumeration value="open"/>
      <xs:enumeration value="readonly"/>
      <xs:enumeration value="readwrite"/>
      <xs:enumeration value="release"/>
      <xs:enumeration value="select"/>
      <xs:enumeration value="set"/>
      <xs:enumeration value="show"/>
      <xs:enumeration value="unbind"/>
      <xs:enumeration value="valid"/>
      <xs:enumeration value="warning"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The operation name. A union so that operations this project adds in
       JavaScript (boot.addOperation("validate", ...) — see "Additional
       Operations" in the XIOS/3 manual) validate alongside the built-in set,
       which stays enumerated so completion and hover still describe each one. -->
  <xs:simpleType name="t_operationName">
    <xs:union memberTypes="t_operationNameBuiltIn t_operationNameCustom"/>
  </xs:simpleType>

  <!-- Operations added by the project. Any name the built-in list does not
       already cover; the schema cannot know what a project registers. -->
  <xs:simpleType name="t_operationNameCustom">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="t_operationNameBuiltIn">
    <xs:restriction base="xs:string">
        <xs:enumeration value="action">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation enables the developer to perform a number of actions on components. All available actions are listed in the "Actions" section of the Reference manual, with examples and a list of components that the action can be applied to. This operation is asynchronous.</p><pre><code>&lt;operation name="action" value="#view1"&gt;<br/>&#32;&#32;&lt;component name="menu1" action="open"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="bind">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation enables users to bind data to components, thus utilizing the strength with XIOS/3 to have UI components intelligently bound to data models.</p><pre><code>&lt;operation name="bind" value="#view1#tree1"&gt;<br/>&#32;&#32;&lt;component view="view1" name="list2"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="call">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to call other steps.</p><pre><code>&lt;operation name="call" value="hideButton"&gt;<br/>&#32;&#32;&lt;timer wait="2000" alias="timerId"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="callMethod">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to execute methods on components and even to send parameters to them.</p><pre><code>&lt;operation name="callMethod" value="#view1#component3"&gt;<br/>&#32;&#32;&lt;method name="setValue"&gt;<br/>&#32;&#32;&#32;&#32;&lt;param type="string"&gt;hello&lt;/param&gt;<br/>&#32;&#32;&lt;/method&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="callService">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation allows XIOS/3 applications to communicate with external web services</p><pre><code>&lt;operation name="callService" value="query://statistics"&gt;<br/>&#32;&#32;&lt;document&gt;temp://result&lt;/document&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="change">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to manipulate XML data and is the key to using the Data Virtualization Layer.</p><pre><code>&lt;operation name="change" value="#view1#component1"&gt;<br/>&#32;&#32;&lt;store select="task/@complete" type="replaceText"&gt;true&lt;/store&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="channel">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to create a communicator that can communicate to a REST API or Web Service API. The channel can then either be used directly to access resources like static web sites, used from other operations like callService, or used as communications layer for more complex abstractions like databases and filesystems.</p><pre><code>&lt;operation name="channel"&gt;<br/>&#32;&#32;&lt;name&gt;https&lt;/name&gt;<br/>&#32;&#32;&lt;title&gt;HTTPS&lt;/title&gt;<br/>&#32;&#32;&lt;protocol&gt;HTTPS&lt;/protocol&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="config">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Reads and writes stored application properties, through getProperty and setProperty. Not in the published reference; taken from production process code.</p><pre><code>&lt;operation name="config" value="cbe/intro"&gt;<br/>&#32;&#32;&lt;getProperty alias="introGuide"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="system">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>System-level actions, such as logging the current identity out. Not in the published reference; taken from production process code.</p><pre><code>&lt;operation name="system"&gt;<br/>&#32;&#32;&lt;logout/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="download">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Downloads a document to the user's device. Not in the published reference; taken from production process code.</p>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="close">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to close documents from XIOS/3, by clearing them from the cache.</p><pre><code>&lt;operation name="close" value="addUser"&gt;<br/>&#32;&#32;&lt;mode&gt;view&lt;/mode&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="confirm">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to display a confirmation dialog.</p><pre><code>&lt;operation name="confirm"&gt;<br/>&#32;&#32;&lt;message&gt;Something happened!&lt;/message&gt;<br/>&#32;&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="create">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to create an XML node-set by creating a new Object (temporary document).</p><pre><code>&lt;operation name="create" value="#Clipboard"&gt;<br/>&#32;&#32;&lt;clipboard/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="database">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation offers various ways of handling database instructions.</p><pre><code>&lt;operation name="database" value="https://xios3.com/image.jpg"&gt;<br/>&#32;&#32;&lt;attach to="home://myFile.xml" slot="2"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="debug">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to debug applications when developing for XIOS/3.</p><pre><code>&lt;operation name="debug" value="Text output in debug window"/&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="decision">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation defines a switch-statement which is used to test conditions.</p><pre><code>&lt;operation name="decision" value="tenant://myTable"&gt;<br/>&#32;&#32;&lt;when exists="true"&gt;<br/>&#32;&#32;&#32;&#32;&lt;operation name="debug" value="Container exists"&gt;alert:plain&lt;/operation&gt;<br/>&#32;&#32;&lt;/when&gt;<br/>&#32;&#32;&lt;when exists="false"&gt;<br/>&#32;&#32;&#32;&#32;&lt;operation name="debug" value="Container needs to be created"&gt;alert:plain&lt;/operation&gt;<br/>&#32;&#32;&lt;/when&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="foreach">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation allows you to iterate (loop) using a counter similar to a for( let i = 0; i &lt; 10; i++ ) { } construct. It also allows looping over an XML node set provided in the value attribute. For each iteration it makes, it will execute its child operations.</p><pre><code>&lt;operation name="foreach" value="home://Documents/#db:container/db:object"&gt;<br/>&#32;&#32;&lt;operation name="debug" value="Document {!#@name}"&gt;alert:plain&lt;/operation&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="friends">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation allows you to perform actions on friends or friend groups in the #Friends document (the user's list of friends).</p>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="groups">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation allows you to perform action and receive information from groups.</p><pre><code>&lt;operation name="groups"&gt;<br/>&#32;&#32;&lt;accept to="home://Groups/{$group}"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="login">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation allows you to connect to password protected web services.</p><pre><code>&lt;operation name="login" value="cbe"&gt;<br/>&#32;&#32;&lt;username&gt;{#Login#Username}&lt;/username&gt;<br/>&#32;&#32;&lt;password&gt;{#Login#Password}&lt;/password&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="navigate">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to navigate in the selection relative to XML documents.</p><pre><code>&lt;operation name="navigate" value="!"&gt;<br/>&#32;&#32;&lt;call axis="following" step="10"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="open">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to open process, view and application documents.</p><pre><code>&lt;operation name="open" value="$package#view[@name='view2']" /&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="print">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to print documents.</p><pre><code>&lt;operation name="print" value="{#view#richtext.getValue()}"/&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="rollBack">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to rollback transactions.</p><pre><code>&lt;operation name="rollBack" value="#TransactionManager"/&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="save">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to save XML documents.</p><pre><code>&lt;operation name="save" value="home://Documents/myfile.xml"/&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="search">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation makes the text content within an XML document searchable.</p><pre><code>&lt;operation name="search" value="{#Help#searchField}"&gt;<br/>&#32;&#32;&lt;document href="{$dataDoc}" xlink="load-all"/&gt;<br/>&#32;&#32;&lt;output&gt;#search&lt;/output&gt;<br/>&#32;&#32;&lt;elements search="section/text, document/text" ignore="code"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="setSelection">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to set selections on components that are already bound to data.</p><pre><code>&lt;operation name="setSelection" value="$selection"&gt;<br/>&#32;&#32;&lt;component view="Explorer" name="folderSelector"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="share">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used for actions related to Window Sharing and Gesture Based Collaboration.</p><pre><code>&lt;operation name="share"&gt;<br/>&#32;&#32;&lt;zone direction="right" user="goran"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="split">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>This operation is used to split a string into an XML node-set</p><pre><code>&lt;operation name="split" value="{$time}"&gt;<br/>&#32;&#32;&lt;value&gt;use&lt;/value&gt;<br/>&#32;&#32;&lt;document&gt;#arrTime&lt;/document&gt;<br/>&#32;&#32;&lt;token&gt;:&lt;/token&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
        <xs:enumeration value="tenant">
          <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>The tenant operation defines operations related to the tenant e.g users and statistics.</p><pre><code>&lt;operation name="tenant"&gt;<br/>&#32;&#32;&lt;deleteUser type="requestdelete" userid="userId" usedefault="true/false"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
        </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
