<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1" elementFormDefault="qualified">

  <!-- ============================================================= -->
  <!-- process scaffold (framework structure; not from the op docs)  -->
  <!-- ============================================================= -->

  <!-- Component and system events that a trigger can listen for, from the public
       Events reference. Deliberately a union with xs:string rather than a plain
       enumeration: applications define their own event names too (a listview or
       render triggerEvent, or a Shell Command_<name>), so closing the list would
       report valid markup as invalid. The union still drives completion — the
       known names are offered with their documentation. -->
  <xs:simpleType name="t_knownEvent">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Add">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the add tab (+) button is clicked.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AddColumn">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the button to add a column is clicked in the grid.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AddRow">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a new row is added to the grid.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignCenterRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is aligned in the center is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignCenterSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is aligned in the center is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignJustifiedRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has justified alignment is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignJustifiedSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has justified alignment is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignLeftRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is aligned to the left is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignLeftSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is aligned to the left is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignRightRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is aligned to the right is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="AlignRightSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is aligned to the right is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Authorized">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the channel or login operation successfully has authorized a login.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BGColorRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has background color is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BGColorSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has background color is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Blur">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs the user clicks outside the component after having set focus to it.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BoldRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is bold is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BoldSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is bold is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BulletListRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when a bullet list has been released (unselected) inside a component that allows rich text editing.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="BulletListSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when a bullet list has been selected inside a component that allows rich text editing.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Change">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the selected value of the component has been changed.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Changed">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the data bound to the component has been changed.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Close">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the component has been closed.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Closing">
        <xs:annotation><xs:documentation xml:lang="en">In order for this event to occur the handle-close element must be set to the value true in the open operation when opening a view or the handle-close attribute is set on the view element element. The event occurs when the X is clicked to close the application.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ContextMenu">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the user right-clicks on the component.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DateChanged">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a new date has been set.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DecorationRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is underlined is released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DecorationSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is underlined is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Delete">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a selected item in the component has been deleted.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Disabled">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a component is disabled, e.g. from the action disable.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="DoubleClick">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the end user double-clicks on the left mouse button.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Drop">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when something is dropped onto the component.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Edit">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs after editing has been performed on data in the component. To initiate editing see: callMethod edit.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="EditEnd">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs after the editfield is closed no matter if changes have been made.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Empty">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the component is emptied.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Enabled">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a component is enabled, e.g. from the action enable.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Enter">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when hitting the Enter key while the component is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Escape">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the ESCAPE key is hit on the keyboard while the component is selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FGColorRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has foreground color has been released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FGColorSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has foreground color has been selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Focus">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when focus has been set on the component.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FontFamilyRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has font-family style has been released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FontFamilySelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has font-family style has been selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FontSizeRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has font-size style has been released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="FontSizeSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that has font-size style has been selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Fullscreen">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the component is displayed in full screen.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Header">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the user clicks on the header of grid.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HeaderContextMenu">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the user right-clicks on the header of grid.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Hide">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a component is hidden, e.g. from the action hide.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Hover">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the end user hovers over the component with the pointer.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="HttpHyperlink">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when a hyperlink (https://) is clicked inside a richtext component.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Init">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the component is rendered.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ItalicRelease">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is italic has been released.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ItalicSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when text that is italic has been selected.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Key">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a keyboard key has been pressed (onKeyDown) while the focus in on a supported component. The trigger does not contain any XML information.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Loaded">
        <xs:annotation><xs:documentation xml:lang="en">This event is triggered by the view when the entire view with its components is setup and ready, i.e. loaded.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Login">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the channel operation requires a login to continue and open the channel. Typically when the login event is triggered, a login dialog should be displayed that prompts the end-user for a username and password.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="LoginFailure">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the login operation has failed to authorize a login.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Menu">
        <xs:annotation><xs:documentation xml:lang="en">This event is fired from two different components in two different ways. For the calendar component the event occurs when the end user right-clicks (requests a contextMenu) on the Calendar component, while not selecting any appointments (data).</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Move">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the content of the component has been moved.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="MoveItem">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the end user drags a selected item.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="NumberListSelect">
        <xs:annotation><xs:documentation xml:lang="en">(RichText component) This event occurs when a numbered list has been selected inside a RichText editor.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Opened">
        <xs:annotation><xs:documentation xml:lang="en">This event is triggered by the view when the entire view with its components is visible. The event comes after the Loaded event.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Paste">
        <xs:annotation><xs:documentation xml:lang="en">This event will occur when the user clicks on Ctrl+V. It will result in the paste-node being the trigger.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ReadOnly">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a component is made read only, e.g. from the action readonly.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="ReadWrite">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a component is made read/write, e.g. from the action readwrite.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Ready">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a component with external dependencies has been loaded and can accept interaction.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Release">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs on mouse up or when something is deselected depending on the specific component.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Saved">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs then the data bound to the component has been saved.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Select">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the component has been selected. It is equivalent to onclick (and in some cases to onmousedown).</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SelectedDate">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when a date is selected and displayed in the Calendar.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SelectedMore">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when an event has been extended from a single day to two or more while in single day view.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SetActive">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs once the view has been focused.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Show">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the component is displayed, e.g. from the action show.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="SubjectMore">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the More Details link is clicked in the Calendar Quick Event Scheduler.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="Tab">
        <xs:annotation><xs:documentation xml:lang="en">This event occurs when the tab button is hit.</xs:documentation></xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="TriggerEvent">
        <xs:annotation><xs:documentation xml:lang="en">This event allows you to catch your own defined events from the ListView and Render components. In listview components the trigger will contain the selection data.</xs:documentation></xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="t_eventName">
    <xs:union memberTypes="t_knownEvent xs:string"/>
  </xs:simpleType>

  <xs:complexType name="t_trigger">
    <!-- trigger/@event, @step, @view, @component, @communicator are all exercised by reference examples. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Binds an event to a step. A component event is a signal thrown to the process; the trigger runs the step named in its step attribute whenever that event occurs on the named view, optionally narrowed to a single component within it. The event data is available inside the step as the trigger expression (!). Use communicator instead of view to listen for events from a channel created by the channel operation.</p><pre><code>&lt;process name="Demo"&gt;<br/>&#32;&#32;&lt;trigger view="bushView" event="Loaded" step="init"/&gt;<br/>&#32;&#32;&lt;trigger view="mobileMenu" component="menu" event="Select" step="showPanel"/&gt;<br/>&lt;/process&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <!-- Declaration order is the order vscode-xml offers these in completion, so
         it follows the house style for writing a trigger:
             <trigger view="DE" component="tShowEula" event="Select" step="showEula"/>
         Keep them in this order. -->

    <!-- view is not required: a trigger listens either to a view (optionally
         narrowed to one component) or to a communicator, and the reference's own
         example <trigger communicator="xios" event="Login" step="20"/> has no
         view at all. XSD 1.0 cannot express "exactly one of view/communicator",
         and the 1.1 assertions that could are unsupported by vscode-xml, so this
         is left open rather than rejecting valid markup. -->
    <xs:attribute name="view" type="xs:string"/>
    <xs:attribute name="component" type="xs:string"/>
    <xs:attribute name="event" type="t_eventName" use="required"/>
    <xs:attribute name="step" type="xs:string" use="required"/>
    <xs:attribute name="communicator" type="xs:string"/>
    <xs:attribute name="process" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_step">
    <!-- @success/@error/@goto are schema-declared; only @id and @name appear in reference examples. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A named unit of process logic, run when a trigger, a call operation or a decision routes to its id. Contains aliases and operations, executed in document order. The success, error and goto attributes name the step to continue with; server errors returned by the callService operation are routed to the trigger event (!) of the step named in error.</p><pre><code>&lt;step id="init"&gt;<br/>&#32;&#32;&lt;operation name="bind" value="#componentList"&gt;<br/>&#32;&#32;&#32;&#32;&lt;component view="bushView" name="myBush" select="components"/&gt;<br/>&#32;&#32;&lt;/operation&gt;<br/>&lt;/step&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias"/>
      <xs:element ref="operation"/>
      <!-- Shorthand for <operation name="debug">, which the reference uses as a
           sibling of operations inside a step:
             <operation name="groups" value="tenant">…</operation>
             <debug value="$listResponse"/>
           Only debug is admitted here; the other names in g_opChildren are
           instructions belonging to a specific operation, not step-level steps. -->
      <xs:element name="debug" type="op__leaf"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="description" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Free-text note about what the step does.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="success" type="xs:string"/>
    <xs:attribute name="error" type="xs:string"/>
    <xs:attribute name="goto" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_decision">
    <!-- SCHEMA-DERIVED: the reference has no page for the process-level decision element and no example of it. Prose and example are inferred from the content model and from the decision operation, which branches the same way. Worth confirming against the runtime. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A branch point declared as a direct child of process, routing to a step by testing conditions. Each when is evaluated in document order and the first one that matches routes to its step; otherwise supplies the fallback. The same branching is available inside a step through the decision operation.</p><pre><code>&lt;decision id="chooseView"&gt;<br/>&#32;&#32;&lt;when test="{screen('phone')}" step="mobile"/&gt;<br/>&#32;&#32;&lt;otherwise step="desktop"/&gt;<br/>&lt;/decision&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="when" type="t_when"/>
      <xs:element name="otherwise" type="t_otherwise"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_when">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Tests a condition inside a decision. test holds the condition to evaluate; exists tests whether the value on the parent resolves to an existing node. The first when whose condition is true routes to the step named in its step attribute.</p><pre><code>&lt;when test="{contains('{$loginLogo}', 'http')}" step="hasLogo"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="step" type="xs:string" use="required"/>
    <xs:attribute name="exists" type="xs:boolean"/>
    <xs:attribute name="test" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_otherwise">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Fallback branch of a decision. Routes to the step named in its step attribute when no preceding when condition matched.</p><pre><code>&lt;otherwise step="desktop"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="step" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:simpleType name="t_model">
    <xs:restriction base="xs:string">
      <xs:enumeration value="base"/>
      <xs:enumeration value="browse"/>
      <xs:enumeration value="data"/>
      <xs:enumeration value="dataDoc"/>
      <xs:enumeration value="define"/>
      <xs:enumeration value="expand"/>
      <xs:enumeration value="folder"/>
      <xs:enumeration value="global"/>
      <xs:enumeration value="new"/>
      <xs:enumeration value="newsilent"/>
      <xs:enumeration value="open"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="value"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="t_alias" mixed="true">
    <!-- @title and @when are schema-declared only; no reference example or prose covers them. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Declares a named value for use later in the process, referenced from expressions as $name. The value attribute holds the expression to evaluate. The model attribute selects how the value is interpreted - for example data to hold an XML data document, or new and newsilent to create a new document. An alias with no value declares the name without assigning it.</p><pre><code>&lt;alias name="time" value="{format('hh:mm')}"/&gt;<br/>&lt;alias name="searchResults" value="home://search(/Documents/,type:text/xml)" model="data"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <!-- model="new"/"newsilent" creates a document whose initial content is the
         alias's own child XML, so the content is application data and is skipped
         rather than validated. A <dialog> child (see t_dialog) configures the
         value for the models that prompt; it cannot be declared alongside the
         wildcard without breaking unique particle attribution. -->
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <!-- Not required: production process code declares a bare <alias/> and
         assigns to it later. -->
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="model" type="t_model"/>
    <xs:attribute name="mode" type="xs:string"/>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
    <xs:attribute name="when">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="undefined"/>
          <xs:enumeration value="empty"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- <dialog> configures a file/object picker for an alias model. -->
  <xs:complexType name="t_dialog">
    <!-- SCHEMA-DERIVED: the reference has no page for dialog and no example of it. Prose and example are inferred from the content model (t_dialogLabel/@name, t_dialogType/@mime) and from the alias open/new models. Worth confirming against the runtime. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Configures a dialog that supplies the value of the enclosing alias, used with the alias models that open or create a document. title sets the dialog title and folder the location it starts in. The label children name the fields shown, and type restricts the selectable documents by MIME type.</p><pre><code>&lt;alias name="target" model="open"&gt;<br/>&#32;&#32;&lt;dialog title="Pick a document" folder="home://Documents/"&gt;<br/>&#32;&#32;&#32;&#32;&lt;label name="filename"&gt;Document&lt;/label&gt;<br/>&#32;&#32;&#32;&#32;&lt;type mime="text/xml"/&gt;<br/>&#32;&#32;&lt;/dialog&gt;<br/>&lt;/alias&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="label" type="t_dialogLabel"/>
      <xs:element name="type" type="t_dialogType"/>
    </xs:choice>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="folder" type="xs:string"/>
  </xs:complexType>

  <!-- <label name="ok">Open Object</label> — a named button/label with text. -->
  <xs:complexType name="t_dialogLabel">
    <!-- SCHEMA-DERIVED: no reference page or example covers the dialog children. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Names a field shown in an alias dialog. The name attribute identifies the field and the element's text content is the label displayed for it.</p><pre><code>&lt;label name="filename"&gt;Document&lt;/label&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="name" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- <type mime="text/xml"/> — a MIME filter for the dialog. -->
  <xs:complexType name="t_dialogType">
    <!-- SCHEMA-DERIVED: no reference page or example covers the dialog children. -->
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Restricts an alias dialog to documents of the given MIME type.</p><pre><code>&lt;type mime="text/xml"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="mime" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- <operations> declares the custom operations an application provides.
       The declared @name values become usable as <operation name="..."> in
       steps (accepted as open content by the host validator). -->
  <xs:complexType name="t_operations">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Declares custom operations that the application supplies itself, making them available to the name attribute of operation elements alongside the built-in operations.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="operation" type="t_operationDecl" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="t_operationDecl">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Declaration of a single custom operation. name is the value used in an operation element's name attribute; href points at the JavaScript module implementing it and class names the exported class.</p>]]></xs:documentation>
    </xs:annotation>
    <!-- The same type as an operation call's @name, deliberately. The schema
         holds two element declarations called "operation" — this one and the
         instruction inside a step — and the language server resolves an
         attribute to one of them by name. When they disagreed, declaring an
         <operations> block cost the built-in operations their completion
         everywhere in the document. -->
    <xs:attribute name="name" type="t_operationName" use="required"/>
    <xs:attribute name="href" type="xs:anyURI"/>
    <xs:attribute name="class" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="process">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Root of a process document, and the container for the process logic of an application. Holds trigger elements that bind events to steps, step elements containing the operations to run, decision elements that branch between steps, and an operations element declaring custom operations.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="operations" type="t_operations"/>
      <xs:element name="script" type="t_processScript"/>
      <xs:element name="trigger" type="t_trigger"/>
      <xs:element name="step" type="t_step"/>
      <xs:element name="decision" type="t_decision"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="author" type="xs:string"/>
    <xs:attribute name="created" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="revised" type="xs:string"/>
  </xs:complexType>

  <xs:element name="process" type="process"/>

  <!-- A JavaScript file the process loads, so its steps can call the functions
       it defines through the javascript operation. href is relative to the
       process document. -->
  <xs:complexType name="t_processScript" mixed="true">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Loads a JavaScript file alongside the process, so its steps can call the functions it defines. <code>href</code> is resolved relative to the process document.</p><pre><code>&lt;script href="javascript/database.js"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="href" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Where to load the script from, relative to the process document.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">An optional name for the script.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>


  <!-- operation element. Per-@name typing needed XSD 1.1 CTA (unsupported by
       vscode-xml), so it uses the op__any fallback: @name is required and
       validated against the known operations; other attributes (e.g. value)
       and child content are left open. -->
  <xs:element name="operation" type="op__any"/>

  <xs:complexType name="op__leaf" mixed="true">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A child element of a process operation. Which children are meaningful depends on the parent operation, so see the documentation on the operation's name attribute, or on the individual instruction elements of the change, database, groups and tenant operations. Attributes are left open because they differ per instruction.</p>]]></xs:documentation>
    </xs:annotation>
    <!-- Open content: see the globally declared operation children below. -->
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="op__branch" mixed="true">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A when or otherwise branch of the decision operation. Either routes to a step through the step attribute, or, when no step is given, executes the operations it contains. test holds the condition to evaluate and exists tests for the existence of the operation's value.</p><pre><code>&lt;operation name="decision" value="tenant://myTable"&gt;<br/>&#32;&#32;&lt;when exists="true"&gt;<br/>&#32;&#32;&#32;&#32;&lt;operation name="debug" value="Container exists"&gt;alert:plain&lt;/operation&gt;<br/>&#32;&#32;&lt;/when&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <!-- Open content: see the globally declared operation children below. -->
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="test" type="xs:string"/>
    <xs:attribute name="exists" type="xs:string"/>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- Content that is data rather than XIOS markup: arbitrary element names the
       schema cannot know (HTTP header names) or an XML node-set the application
       supplies. Skipped rather than validated, and deliberately NOT part of
       g_opChildren so the instruction vocabulary stays closed and useful. -->
  <xs:complexType name="op__payload" mixed="true">
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="op__any" mixed="true">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A single instruction in a step. The name attribute selects which operation runs - hover it for that operation's own description and example. The value attribute usually carries the target the operation acts on, such as a component reference, a document URL or an expression; child elements configure the operation.</p><pre><code>&lt;operation name="action" value="#view1"&gt;<br/>&#32;&#32;&lt;component name="menu1" action="open"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <!-- Open content: see the globally declared operation children below. -->
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" use="required" type="t_operationName">
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- operation: action -->
  <xs:complexType name="op_action">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="component" type="op_action__component" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="action"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_action__component" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="action" type="t_componentAction" use="required"/>
  </xs:complexType>

  <!-- operation: bind -->
  <xs:complexType name="op_bind">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="component" type="op_bind__component" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="paging" type="op_bind__paging" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="bind"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_bind__component">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="view" type="xs:string" use="required"/>
    <xs:attribute name="select" type="xs:string"/>
    <xs:attribute name="model" default="default">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="default"/>
          <xs:enumeration value="none"/>
          <xs:enumeration value="data"/>
          <xs:enumeration value="clone"/>
          <xs:enumeration value="base"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="transformer" type="xs:string"/>
    <xs:attribute name="type" default="default">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="default"/>
          <xs:enumeration value="focus"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="eval" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="op_bind__paging">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="size" type="xs:integer" use="required"/>
    <xs:attribute name="ascending" type="xs:boolean" default="true"/>
    <xs:attribute name="order" type="xs:string"/>
  </xs:complexType>

  <!-- operation: call -->
  <xs:complexType name="op_call">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="trigger" type="op_call__trigger" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="yield" type="op_call__yield" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="param" type="op_call__param" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="timer" type="op_call__timer" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="call"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_call__trigger">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="model" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_call__yield">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_call__param">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_call__timer">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="alias" type="xs:string"/>
    <xs:attribute name="interval" type="xs:string"/>
    <xs:attribute name="wait" type="xs:integer"/>
  </xs:complexType>

  <!-- operation: callMethod -->
  <xs:complexType name="op_callMethod">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="method" type="op_callMethod__method" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="callMethod"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="wait" type="xs:boolean" default="false"/>
    <xs:attribute name="then" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_callMethod__method">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="param" type="op_callMethod__method__param" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_callMethod__method__param" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="type" default="string">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="string"/>
          <xs:enumeration value="boolean"/>
          <xs:enumeration value="integer"/>
          <xs:enumeration value="float"/>
          <xs:enumeration value="null"/>
          <xs:enumeration value="xml"/>
          <xs:enumeration value="winEvt"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- operation: callService -->
  <xs:complexType name="op_callService">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="body" type="op_callService__body" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="document" type="op_callService__document" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="expect" type="op_callService__expect" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="headers" type="op_callService__headers" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="method" type="op_callService__method" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="param" type="op_callService__param" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="silent" type="op_callService__silent" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="wait" type="op_callService__wait" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="only-url" type="op_callService__only-url" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="callService"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_callService__body">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="type" type="xs:string"/>
    <xs:attribute name="eval" type="xs:string" default="true"/>
  </xs:complexType>
  <xs:complexType name="op_callService__document">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__expect">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="attempts" type="xs:string" default="30"/>
    <xs:attribute name="timeout" type="xs:string" default="10"/>
  </xs:complexType>
  <xs:complexType name="op_callService__headers">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__method">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__param">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_callService__silent">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__wait">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__only-url">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <!-- operation: change -->
  <xs:complexType name="op_change">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="store" type="op_change__store" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>The store element offers five ways of storing data: append, replace, replaceText, prepend, insert, insertAfter, and insertInto. It defines that the information should be stored according to the option chosen in the type attribute.</p><pre><code>&lt;operation name="change" value="#view1#component1"&gt;<br/>&#32;&#32;&lt;store select="task/@complete" type="replaceText"&gt;true&lt;/store&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="move" type="op_change__move" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Instruction of the change, database operations.</p><p>In change: Moves an XML node-set from one part of the document to another part</p><p>In database: The move instruction is used to move Objects and Containers and has two attributes, to and silent.</p><pre><code>&lt;operation name="database" value="home://Documents/MyDocument.xml"&gt;<br/>&#32;&#32;&lt;move to="home://Applications/" silent="true"/&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="delete" type="op_change__delete" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Instruction of the change, database, groups operations.</p><p>In change: Deleting data is done by either deleting the current selection of a component or by supplying an XPath expression in the select attribute.</p><pre><code>&lt;operation name="change" value="home://Documents/"&gt;<br/>&#32;&#32;&lt;delete select="/db:result/db:object[@name='{$fileTitle}']"/&gt;<br/>&lt;/operation&gt;</code></pre><p>In database: The delete instruction is used to delete Objects and Containers and has two attributes, permanent and silent, both which are boolean type attributes.</p><pre><code>&lt;operation name="database" value="home://Documents/MyDocument.xml"&gt;<br/>&#32;&#32;&lt;delete permanent="true" silent="false"/&gt;<br/>&lt;/operation&gt;</code></pre><p>In groups: Deletes a group, role, or subgroup to a group.</p><pre><code>&lt;operation name="groups" value="$pathToGroup"&gt;<br/>&#32;&#32;&lt;delete type="group" /&gt;<br/>&lt;/operation&gt;</code></pre>]]></xs:documentation></xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="change"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_change__store" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="select" type="xs:string"/>
    <xs:attribute name="transformer" type="xs:string"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="append"/>
          <xs:enumeration value="insert"/>
          <xs:enumeration value="insertIntoText"/>
          <xs:enumeration value="move"/>
          <xs:enumeration value="prepend"/>
          <xs:enumeration value="replace"/>
          <xs:enumeration value="replaceText"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_change__move">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_change__delete">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="select" type="xs:string"/>
  </xs:complexType>

  <!-- operation: channel -->
  <xs:complexType name="op_channel">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="name" type="op_channel__name" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="protocol" type="op_channel__protocol" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="adapter" type="op_channel__adapter" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="title" type="op_channel__title" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="authentication" type="op__leaf" minOccurs="0" maxOccurs="unbounded">
      <xs:annotation><xs:documentation xml:lang="en"><![CDATA[<p>Credentials for a channel, alongside its name, protocol and adapter.</p><pre><code>&lt;authentication type="bearer"&gt;<br/>&#32;&#32;&lt;username&gt;{$apiKey}&lt;/username&gt;<br/>&#32;&#32;&lt;password/&gt;<br/>&lt;/authentication&gt;</code></pre>]]></xs:documentation></xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="channel"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_channel__name" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="op_channel__protocol__text">
    <xs:restriction base="xs:string">
      <xs:enumeration value="HTTPS"/>
      <xs:enumeration value="XMLDB"/>
      <xs:enumeration value="PROXY"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="op_channel__protocol">
    <xs:simpleContent>
      <xs:extension base="op_channel__protocol__text"/>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="op_channel__adapter">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="path" type="xs:string"/>
    <xs:attribute name="in" type="xs:string"/>
    <xs:attribute name="out" type="xs:string"/>
    <xs:attribute name="type">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="CompactJSON"/>
          <xs:enumeration value="XSLT"/>
