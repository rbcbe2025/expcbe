  </xs:complexType>

  <!-- The face and hands of an analog clock. -->
  <xs:complexType name="t_clock_style">
    <xs:attribute name="href" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Image used for the clock face.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hour" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour of the hour hand.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour of the minute hand.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sec" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour of the second hand.</xs:documentation>
      </xs:annotation>
