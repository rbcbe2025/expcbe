    <xs:attribute name="selectable" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="prompt" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The prompt drawn before each command. Default &gt;; none draws no prompt.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scroll" type="t_scroll">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the shell overflows: auto, scroll, visible or false.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <!-- The banner the shell prints on startup. Its text is written as content, or
       as an l:text child when it is localised; xios="false" drops the runtime's
       own banner. -->
  <xs:complexType name="t_shell_banner" mixed="true">
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="xios" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the standard XIOS/3 banner is printed above this one.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A set of macro definitions, gathered under one element. -->
  <xs:complexType name="t_shell_macros">
    <xs:sequence>
      <xs:element name="macro" type="t_shell_macro" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A named colour theme the shell can switch to. The colour attributes are
       written both hyphenated (bg-color) and camel cased (bgColor) in real
       markup, so they are accepted as written rather than enumerated. -->
  <xs:complexType name="t_shell_look">
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">The name the theme is selected by, through the shell's look attribute.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="font" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Font family used for the shell text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A shortcut that expands to one or more shell commands, separated by |.
       $ stands for the arguments it was called with. -->
  <xs:complexType name="t_shell_macro" mixed="true">
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">What the user types to run the macro.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="description" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shown next to the macro in the shell's help.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A heading the shell's help lists its commands under. -->
  <xs:complexType name="t_shell_group" mixed="true">
    <xs:sequence>
      <xs:element name="command" type="t_shell_command" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">The group heading.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A command this application adds to the shell. Selecting it raises the
       shell's Command_&lt;name&gt; event, which a process trigger listens for. -->
  <xs:complexType name="t_shell_command" mixed="true">
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">What the user types to run the command.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The value the command passes on when it runs.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="desc" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shown next to the command in the shell's help.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>


  <xs:complexType name="t_iconlist_item">
    <xs:attribute name="currentsize" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Space currently used, for an item representing a drive.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="totalsize" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Total space available, for an item representing a drive.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovericon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown while the pointer is over the item.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="drivecolor" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour used for the drive the item represents.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">The text to display, use</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon to render next to text, use the</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Specify an optional name for each item, example</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Overrides the iconlist default style of every list item</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tooltip shown while the pointer rests on the item.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The value the item carries, returned by getValue when it is selected.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="renamepath" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Where in the bound data a rename writes the new name.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The group the item belongs to, for an iconlist with group="true" or layout="submenu".</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS class name(s) to apply to the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_bush_item">
    <xs:attribute name="display" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">XPath expression relative to the match attribute</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon to render right of the display text</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="draggable" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If rendered branches of the tree should be draggable</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="open" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines if the tree branch should be expanded</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="renamepath" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">XPath expression pointing to the XML node to be renamed if the tree node is renamed</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS class name(s) to apply to the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_bush">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A tree-type component that uses lazy loading to build the tree, expanding branches as the user clicks them. Suited to large trees such as a communicator database (for example main://); for a smaller dataset like a single XML document the tree component is usually a better choice.</p><pre><code>&lt;bush name="myBush" width="100%" height="100%" look="marble"&gt;<br/>&#32;&#32;&lt;rule match="components"&gt;<br/>&#32;&#32;&#32;&#32;&lt;item display="Component List" icon="icon://pieces"/&gt;<br/>&#32;&#32;&lt;/rule&gt;<br/>&#32;&#32;&lt;rule match="component"&gt;<br/>&#32;&#32;&#32;&#32;&lt;item display="{@name}" icon="icon://piece"/&gt;<br/>&#32;&#32;&lt;/rule&gt;<br/>&#32;&#32;&lt;rule match="component/documentation"&gt;<br/>&#32;&#32;&#32;&#32;&lt;item display="{description}" icon="icon://pencil"/&gt;<br/>&#32;&#32;&lt;/rule&gt;<br/>&lt;/bush&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="rule" type="t_rule" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="item" type="t_bush_item" minOccurs="0" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
        <xs:attribute name="bgcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Specify the background color for titled</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="focusnew" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Decides if the tree should focus on newly created nodes in the tree</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Show a selection hover over the tree when the mouse if moved</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="layout" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Change the layout of the bush component</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="look" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Change the look and feel of the bush component</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multiple" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If it should be possible to select multiple nodes in the tree</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sort" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Enables sorting of the tree nodes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sortproperty" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which property to use for sorting the tree nodes, e.g.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Overrides the component's default style</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="wait" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text label to show while the bush is fetching additional data as it lazy loads</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hideroot" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scroll" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:attributeGroup name="t_iconlist_attributes">
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="arrangeitems" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Automatically arranges the order of the items in the list</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="draggableitems" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether items can be dragged. The hyphenated draggable-items is also declared; production markup uses this form.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="look" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Named appearance for the list. Left as a string: the valid set for iconlist is not documented.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="deselect" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If deselection should be possible</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="draggable-items" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Makes items in the list draggable</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fixedcontainer" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Set the width of items to a fixed size (applies only when layout is set to thumbnail or albumicon)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="group" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Group items together</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Visualize hover of items by cursor</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="iconmode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Rendering flow of list as horizontal or vertical</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="iconsize" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">The size of displayed icons in list in pixels</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="layout">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation xml:lang="en">The iconlist component have several layouts that it can use to render the list of icons</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="albumicon"/>
          <xs:enumeration value="columns"/>
          <xs:enumeration value="default"/>
          <xs:enumeration value="drives"/>
          <xs:enumeration value="drivesDetailed"/>
          <xs:enumeration value="drivesMenu"/>
          <xs:enumeration value="icon"/>
          <xs:enumeration value="list"/>
          <xs:enumeration value="listdetail"/>
          <xs:enumeration value="mail"/>
          <xs:enumeration value="miniature"/>
          <xs:enumeration value="playlist"/>
          <xs:enumeration value="submenu"/>
          <xs:enumeration value="subpanel"/>
          <xs:enumeration value="sectionlist"/>
          <xs:enumeration value="text"/>
          <xs:enumeration value="textListColumn"/>
          <xs:enumeration value="thumbnail"/>
          <xs:enumeration value="tracklist"/>
          <xs:enumeration value="treelist"/>
          <xs:enumeration value="vertical"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="lasso" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allow lasso selection of multiple items</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="loading-image" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Change the built in wait icon for a loading image, specify as a path to image.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multipleselect" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allow multiple selections</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="paging">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation xml:lang="en">How to reach content past the first page: a "more" button, scrolling, or not at all. Written empty as often as it is written none.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value=""/>
          <xs:enumeration value="more"/>
          <xs:enumeration value="scroll"/>
          <xs:enumeration value="none"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="partialupdate" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If partial updates to the rendered content should be made instead of full re-rendering of content</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rightselect">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation xml:lang="en">If rightclick selection should be enabled or enabled without returning an event</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="true"/>
          <xs:enumeration value="false"/>
          <xs:enumeration value="noevent"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="selecttype">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation xml:lang="en">Make icon list a selection (toggle) or makes click on icon a direct selection (for instance to trigger
              something that opens with a single click) through execute</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="execute"/>
          <xs:enumeration value="toggle"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="scroll">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation xml:lang="en">Controls the scroll behavior</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="auto"/>
          <xs:enumeration value="scroll"/>
          <xs:enumeration value="hidden"/>
          <xs:enumeration value="false"/>
          <xs:enumeration value="true"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sort">
      <xs:simpleType>
        <xs:annotation>
          <xs:documentation xml:lang="en">Set the sort order of the icon list, sort a-z, z-a, or based on position in the data document</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
          <xs:enumeration value="ascending"/>
          <xs:enumeration value="descending"/>
          <xs:enumeration value="position"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="sortproperty" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which key should the sort be done on? Example; name, text</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Overrides the component's default style</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="textstyle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Overrides the iconlist default style of every item text label</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unselectevents" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Fires a select event with no selection if no icon is selected</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:attributeGroup>

  <!-- The columns an iconlist or filelist draws in its list layouts. Leaving
       the block out generates five defaults: icon, Name, Size, Type, Modified. -->
  <xs:complexType name="t_listColumns">
    <xs:sequence>
      <xs:element name="column" type="t_listColumn" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_listColumn">
    <xs:attribute name="attribute" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which property of the listed object the column shows: icon, h1, h2, size, modified, and so on.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The column heading.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Width of the column in pixels, or fill to take the remaining room.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sortproperty" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The property the column sorts on, when it differs from the one it shows.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sorttype" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Set to numeric to sort the column as numbers rather than text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rename" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the value in this column can be renamed in place.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_iconlist">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Visualize a list of entries as series of icons.</p><pre><code>&lt;iconlist name="boards" width="150" height="100%" layout="submenu" deselect="false" scroll="false" iconsize="24" style="background-color: #555;"&gt;<br/>&#32;&#32;&lt;rule match="db:container"&gt;<br/>&#32;&#32;&#32;&#32;&lt;item text="{@name}" icon="icon://folders2?color=fff"/&gt;<br/>&#32;&#32;&lt;/rule&gt;<br/>&lt;/iconlist&gt;</code></pre>]]></xs:documentation>
