    </xs:attribute>
    <xs:attribute name="rowspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance by style code</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tabs" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Enables or disables the display of tabs in the tabstrip</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-expanded" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="defaultValue" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The tab the hidden-tabs switcher starts on.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxChars" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Longest tab label in the hidden-tabs switcher before it is truncated. Default -1.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tabheight" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Height of a tab in pixels. Default 24; set it when CSS changes the tab height.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_breadcrumbs">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A bredcrumb bar visualizing the path into a structure.</p><pre><code>&lt;breadcrumbs name="breadcrumbs" height="20" width="100%" style="font-size: 12px; padding-top: 2px; padding-bottom: 3px;"<br/>&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;max-chars="15" default="Databases" l:default="Databases"&gt;<br/>&#32;&#32;&lt;rule match="db:container" display="{@name}"/&gt;<br/>&#32;&#32;&lt;rule match="db:database[not(@hidden = 'true')]" display="{@friendly}"/&gt;<br/>&lt;/breadcrumbs&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="rule" type="t_rule" />
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="max-chars" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Maximum number of characters per label. Truncates with ellipsis.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="default" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Default value to use if the selected node does not yield any text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="look" type="t_look">
      <xs:annotation>
        <xs:documentation xml:lang="en">Named skin variant.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_panel">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Defines a panel which are infrastructure building blocks in applications, used for arranging other components and creating a desirable layout.</p><pre><code>&lt;panel type="rows" gap="10" padding="5" height="auto"&gt;<br/>&#32;&#32;&lt;panel name="panel1" height="50" look="white" title="Regular Panel"&gt;<br/>&#32;&#32;&#32;&#32;&lt;label name="lab1" text="Normal panel with title attribute"/&gt;<br/>&#32;&#32;&lt;/panel&gt;<br/>&#32;&#32;&lt;panel name="panel2" height="50" look="white" mode="closeable" title="A closeable Panel"&gt;<br/>&#32;&#32;&#32;&#32;&lt;label name="lab2" text="Closeable mode panel"/&gt;<br/>&#32;&#32;&lt;/panel&gt;<br/>&#32;&#32;&lt;panel name="panel3" height="50" look="white" mode="frame" title="A panel with a frame"&gt;<br/>&#32;&#32;&#32;&#32;&lt;label name="lab3" text="Frame mode panel"/&gt;<br/>&#32;&#32;&lt;/panel&gt;<br/>&lt;/panel&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:group ref="g_components" minOccurs="0" maxOccurs="unbounded" />
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="align" type="t_align">
      <xs:annotation>
        <xs:documentation xml:lang="en">Alignment of child components within panel</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bgcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Makes it possible to specify the background color for titled panels</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="border" type="t_border">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines if a border should be used for panels with mode set to 'closeable'</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="closeable" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">This attribute is only applicable for panels defined as children to a tabstrip component. Displays a small close-icon in the upper right corner of the tab.Clicking the icon will send a Close event</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cols" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="colspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">If panel is part of a table; defines how many columns it may span</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="expanded" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If mode = expander, this attribute can be used to define expanded state at startup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="gap" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines the gap between components to be inserted as spacing</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path to icon when used inside other components like Tabstrip and Accordion</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label-align" type="t_align">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label-pos" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="look" type="t_look">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines the graphical look of the panel</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="t_modePanel">
      <xs:annotation>
        <xs:documentation xml:lang="en">Special types of panels acting in different visual modes</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="en">Specifies if the panel should be transparent and the percentage of the transparency</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string"> <!-- FIXME: complicated type -->
      <xs:annotation>
        <xs:documentation xml:lang="en">Sets the inner padding for the panel</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="resize" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rowspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">If panel is part of a table; defines how many rows it may span</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scroll" type="t_scroll">
      <xs:annotation>
        <xs:documentation xml:lang="en">Enable scrollbars within panel</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">In some contexts the panel is handled different if it is selected (i.e. TabStrip and Accordion)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Overrides the style definitions of the panel look</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tabcolor" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">This attribute is only applicable for panels defined as children to a tabstrip component.Sets the colorhue of the tab, overriding the deafult color. Any hexvalue (#xxxxxx) or colorname (i.e  green) is valid</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Create a panel with a title in a frame sourounding the panel</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute ref="l:title" />
    <xs:attribute name="tree-expanded" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="t_type">
      <xs:annotation>
        <xs:documentation xml:lang="en">The layout manager to use for content inside panel</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="valign" type="t_valign">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disable" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lstyle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="position" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="right" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="direction" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Direction a flow panel lays its children out in: row, row-reverse, column or column-reverse.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="element" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The HTML element the panel is wrapped in. Default div.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="margin" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Space outside the panel.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="column-spacing" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Space between the columns of a form layout. Default 10px.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rowpadding" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Padding of each row of a form layout. Default 3.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label-end" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Where a form label ends, for aligning the fields beside it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bgimage" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Image drawn behind the panel.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="color1" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour the gradient starts at, with look="plategrad".</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="color2" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour the gradient ends at, with look="plategrad".</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="contStyle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS applied to the panel content rather than the panel itself.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="marginTop" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Top margin, with mode="round".</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Distance from the top, for a positioned panel.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Distance from the left, for a positioned panel.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alwaysontop" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Keeps the panel above the other panels.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autohide" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Hides the panel until it is needed.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selection-class" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS class applied to the panel while it is selected.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip" />
