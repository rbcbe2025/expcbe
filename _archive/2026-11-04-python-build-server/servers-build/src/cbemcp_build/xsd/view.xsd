    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_container">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>This component hosts other components described by it's rules and dynamically creates and manages these components dependant on the incomming data</p><pre><code>&lt;container name="coButtons" show="all" width="300" height="100"&gt;<br/>&#32;&#32;&lt;rule match="component"&gt;<br/>&#32;&#32;&#32;&#32;&lt;button text="{@name}" width="100"/&gt;<br/>&#32;&#32;&lt;/rule&gt;<br/>&lt;/container&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="rule" type="t_containerRule" minOccurs="0" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="colspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rowspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="scroll" type="t_scroll">
      <xs:annotation>
        <xs:documentation xml:lang="en">Controls the scroll behaviour</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show" type="t_show">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance by style code</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-expanded" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="align" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the container aligns its contents.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="gap" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <!-- The overlays a map draws: a pin, a circle, a filled polygon, or a line.
       Shared as a group because a map holds them directly and a rule draws one
       per matched record, so both places offer the same set. -->
  <xs:group name="g_mapOverlays">
    <xs:choice>
      <xs:element name="marker" type="t_map_marker" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="circle" type="t_map_circle" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="area" type="t_map_area" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="path" type="t_map_path" minOccurs="0" maxOccurs="unbounded" />
    </xs:choice>
  </xs:group>

  <!-- Draws one overlay per record the match selects, the same way an iconlist
       rule draws an item. -->
  <xs:complexType name="t_mapRule">
    <xs:sequence>
      <xs:group ref="g_mapOverlays" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="match" type="xs:string" use="required" />
    <xs:attribute name="display" type="xs:string" />
    <xs:attribute name="children" type="t_flag" />
    <xs:anyAttribute namespace="##any" processContents="skip" />
  </xs:complexType>

  <!-- Where an overlay sits: either lat and lng separately, or both in one pos.
       Shared by every overlay, because each of them is placed the same way. -->
  <xs:attributeGroup name="t_map_position">
    <xs:attribute name="lat" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Latitude, as a number or an expression bound to the data.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lng" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Longitude, as a number or an expression bound to the data.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="pos" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Latitude and longitude in one value, separated by a space, instead of lat and lng.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- A pin on the map. Attributes beyond these are left accepted, because the
       reference documents fewer of them than production markup uses. -->
  <xs:complexType name="t_map_marker">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A pin on the map. Placed with <code>lat</code> and <code>lng</code>, or with a single <code>pos</code>. Inside an <code>&lt;area&gt;</code> it is a corner of the polygon rather than a pin of its own.</p><pre><code>&lt;marker lat="58.434929" lng="15.591756" title="Burger Queen"<br/>&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;icon="icon://hamburger" icon-select="icon://knife_fork" size="20"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name the marker is addressed by, from a process.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="t_map_position"/>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Label shown for the marker.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon drawn for the marker, as an icon:// url or an image path.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-marker" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon drawn for the marker, the spelling the map itself uses for its default.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-select" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon drawn while the marker is selected.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="size" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">Size of the icon in pixels.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="draggable" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the marker can be dragged to a new position.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS class name(s) to apply to the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- The stroke and fill an outlined overlay is drawn with. -->
  <xs:attributeGroup name="t_map_stroke">
    <xs:attribute name="color" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour of the outline.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour the shape is filled with.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">Thickness of the outline in pixels.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Opacity of the shape, 0 to 1.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name the shape is addressed by, from a process.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:attributeGroup>

  <!-- A circle centred on a point, with its radius given in metres. -->
  <xs:complexType name="t_map_circle">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A circle drawn around a point, with <code>radius</code> in metres.</p><pre><code>&lt;circle lat="58.434929" lng="15.591756" color="#ff00ff" radius="700" width="1"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_map_position"/>
    <xs:attributeGroup ref="t_map_stroke"/>
    <xs:attribute name="radius" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Radius of the circle in metres.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A filled polygon. Its corners are the markers it contains, or one points
       attribute holding the lat/lng pairs. -->
  <xs:complexType name="t_map_area">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A filled polygon. Each <code>&lt;marker&gt;</code> inside it is a corner, in order.</p><pre><code>&lt;area color="#008888" fill="#004444"&gt;<br/>&#32;&#32;&lt;marker pos="58.407504 15.597125"/&gt;<br/>&#32;&#32;&lt;marker pos="58.406668 15.585478"/&gt;<br/>&lt;/area&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="marker" type="t_map_marker" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="t_map_stroke"/>
    <xs:attribute name="points" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The corners as lat/lng pairs, instead of one marker per corner.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- A line through a series of points, drawn but not filled. -->
  <xs:complexType name="t_map_path">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A line through a series of points. Each <code>&lt;marker&gt;</code> inside it is a point on the line, in order.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="marker" type="t_map_marker" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="t_map_stroke"/>
    <xs:attribute name="points" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The points on the line as lat/lng pairs, instead of one marker per point.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="weight" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">Thickness of the line in pixels, the spelling the reference uses for a path.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- Per-marker configuration passed through to the map. A block that reads
       its value from the data has to say where with dyn-path — the component
       reports "Missing required dyn-path attribute." without it. -->
  <xs:complexType name="t_map_markerOptions" mixed="true">
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="dyn-path" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Where in the bound data this option reads its value from.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_map">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>The component creates an instance of a Google map.</p><pre><code>&lt;map name="mapComp" controls="false" zoomlevel="11" mapcenter="58.42, 15.63"&gt;<br/>&#32;&#32;&lt;marker lat="58.434929" lng="15.591756" title="Burger Queen"<br/>&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;&#32;icon="icon://hamburger" icon-select="icon://knife_fork" size="20"/&gt;<br/>&#32;&#32;&lt;circle lat="58.434929" lng="15.591756" color="#ff00ff" radius="700" width="1"/&gt;<br/>&#32;&#32;&lt;area color="#008888" fill="#004444"&gt;<br/>&#32;&#32;&#32;&#32;&lt;marker pos="58.407504 15.597125"/&gt;<br/>&#32;&#32;&#32;&#32;&lt;marker pos="58.406668 15.585478"/&gt;<br/>&#32;&#32;&lt;/area&gt;<br/>&lt;/map&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="rule" type="t_mapRule" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="markerOptions" type="t_map_markerOptions" minOccurs="0" maxOccurs="unbounded" />
      <xs:group ref="g_mapOverlays" minOccurs="0" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="controls" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines if controls should be visible</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lat" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Latitude of the point the map centres on at startup, as an alternative to mapcenter.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lng" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Longitude of the point the map centres on at startup, as an alternative to mapcenter.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-marker" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Url to the icon displayed when data is bound to the map</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-select" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Url to the icon displayed when marker is selected</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mapcenter" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The Longitude,Latitude (comma separated) value to use as map center at startup</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="maptype" type="t_mapType">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines which maptype to use when rendering initial map</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multiple" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="show" type="t_show">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-expanded" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zoomlevel" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Sets the zoom level to start with, range 1 - 15</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="key" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Google Maps key. Falls back to the key element in the system configuration when it is absent.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon-size" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">Size of the marker icons in pixels. Default 16.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="position" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Set to fast for a rough geolocation instead of a precise one.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_buttonbox">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>The component creates a buttonbox that can be placed in a toolbar</p><pre><code>&lt;buttonbox name="bbNew" icon="icon://document_new" text="New" title="New"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="g_custom" minOccurs="0" />
      <xs:element name="menu" type="t_menu" minOccurs="0" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="align" type="t_align">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="animate" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="colspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="disabled-icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path to icon to show when buttonbox is in a disabled state ... used to override built-in disabling functionality</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path to icon to show in the Button box</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon2" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="t_modeButtonbox">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="onclick" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="opacity" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="repeat" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rowspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selected" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Indicates if the Button box is selected (true) or not (false)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance by style code</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="submenu" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Reference to submenu to open when selected</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text describing the function of the Button box</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute ref="l:text" />
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute ref="l:title" />
    <xs:attribute name="tree-expanded" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="trigger" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Trigger value for button, if data is equal to the trigger, the button will be selected</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute ref="l:value" />
    <xs:attribute name="iconsize" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Size of the icons on the buttons.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hover" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted by the runtime and used in production markup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hovericon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown while the pointer is over the box.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="textposition" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Where the text sits relative to the icon: default or ontop.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="command" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The editor command this control runs when it sits in a richtext toolbar, for example Bold, Font or FontSize.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
         language namespace appear in real markup. XSD intersects the wildcards a
         type inherits, so this list has to be the same wherever it appears. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="t_group">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>The component is used for grouping other components such as Button boxes in a Toolbar, Radio buttons and Panels</p><pre><code>&lt;group name="group1" mode="mutex"&gt;<br/>&#32;&#32;&lt;radio name="radio1" post-text="One" value="1"/&gt;<br/>&#32;&#32;&lt;radio name="radio2" post-text="Two" value="2"/&gt;<br/>&#32;&#32;&lt;radio name="radio3" post-text="Three" value="3"/&gt;<br/>&lt;/group&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="g_custom" minOccurs="0" />
      <xs:element name="buttonbox" type="t_buttonbox" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="checkbox" type="t_checkbox" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="toggle" type="t_toggle" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="clock" type="t_clock" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="color" type="t_color" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="combobox" type="t_combobox" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="container" type="t_container" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="date" type="t_date" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="group" type="t_group" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="input" type="t_input" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="menu" type="t_menu" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="panel" type="t_panel" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="radio" type="t_radio" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="slider" type="t_slider" minOccurs="0" maxOccurs="unbounded" />
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="align" type="t_align">
      <xs:annotation>
        <xs:documentation xml:lang="en">Sets the alignation of the components Grouped</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="colspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="label-pos" type="xs:string">
      <xs:annotation>
