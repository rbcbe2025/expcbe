  <xs:complexType name="t_dummy">
    <xs:annotation>
      <!-- Hover documentation is rendered as Markdown by LemMinX, but only after
           it runs the text through normalizeSpace() (killing newlines) and then
           an HTML-to-Markdown converter. So structure has to be expressed as
           HTML: <p> for paragraphs, <pre><code> for examples, <br/> for line
           breaks inside them, and &#32; for indentation. Inside the CDATA the
           HTML tags are literal and only the sample's own angle brackets are
           escaped. See the other documented components for the same pattern. -->
      <xs:documentation xml:lang="en"><![CDATA[<p>A component placeholder used to avoid warnings about non-existing components, for example when a process action targets a component that is not in the view. Should be placed directly inside the view element.</p><pre><code>&lt;view name="Test" title="Dummy Test"&gt;<br/>&#32;&#32;&lt;dummy name="one"/&gt;<br/>&#32;&#32;&lt;panel&gt;<br/>&#32;&#32;&#32;&#32;&lt;label name="two" text="Two"/&gt;<br/>&#32;&#32;&lt;/panel&gt;<br/>&lt;/view&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:attribute name="name" type="xs:string">
