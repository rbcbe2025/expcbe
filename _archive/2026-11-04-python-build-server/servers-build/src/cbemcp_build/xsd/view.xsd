    <xs:attribute name="maxWidth" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">Used in production markup alongside the hyphenated spelling.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxHeight" type="t_number">
      <xs:annotation>
        <xs:documentation xml:lang="en">Used in production markup alongside the hyphenated spelling.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- Localized twins (l:title, l:icon, …), as on components. Must be last:
         a wildcard closes the attribute list. -->
    <xs:attribute name="localedirs" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Comma-separated localisation folders the view reads its l: text from.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="logotype" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">110 by 25 logo shown on the splash screen.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoresize" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Resizes the view to its content. Widgets only.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Distance from the top of the screen.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="left" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Distance from the left of the screen.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="top-exclusion" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Pixels at the top of the main view that later windows may not be moved into.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bottom-exclusion" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Pixels at the bottom of the main view that later windows may not be moved into.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="screen" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">A media query, or phone, tablet or desktop. The view is used for rendering only while it evaluates true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="share" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the view can be shared.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="menu" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the view has a menu.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="native-context-menu" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Uses the browser context menu instead of the XIOS/3 one.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="bgblur" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Blur applied to the background image.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:complexType>

  <xs:element name="view" type="t_view" />

  <!-- An expression in place of a literal value: {$alias}, {@attribute},
       {substring(…)}. XIOS substitutes these at runtime, so an attribute that is
       otherwise boolean or numeric has to accept them too. -->
  <xs:simpleType name="t_expression">
    <xs:restriction base="xs:string">
      <xs:pattern value="\{.*\}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="t_flag">
    <xs:union memberTypes="xs:boolean t_expression t_unset"/>
  </xs:simpleType>

  <!-- Written empty as often as it is written false. -->
  <xs:simpleType name="t_unset">
    <xs:restriction base="xs:string">
      <xs:length value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A measurement, which real markup writes as 90%, 120px or auto as well as
       a bare number or an expression. -->
  <xs:simpleType name="t_number">
    <xs:union memberTypes="xs:decimal t_measurement t_expression"/>
  </xs:simpleType>

  <xs:simpleType name="t_measurement">
    <xs:restriction base="xs:string">
      <xs:pattern value="(auto|inherit|(\-?\d+(\.\d+)?(px|%|em|rem|vh|vw|pt)?))"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="t_action">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Not visual. Groups components that do the same job — a menu item and a toolbar button — so a process listens to one name instead of several. Each <code>&lt;component&gt;</code> holds the name of a member component as its text.</p><pre><code>&lt;action name="editGroup"&gt;<br/>&#32;&#32;&lt;component&gt;mEdit&lt;/component&gt;<br/>&#32;&#32;&lt;component&gt;tViewStandard&lt;/component&gt;<br/>&lt;/action&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="component" minOccurs="1" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">The name of a component that belongs to this action, as the element's text.</xs:documentation>
        </xs:annotation>
        <xs:complexType mixed="true">
          <xs:attribute name="name" type="xs:string"/>
          <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
  </xs:complexType>

  <xs:complexType name="t_boxlist">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A box-shaped selector list; the reference use is picking people. Its entries come from a plate component inside it, normally an <code>&lt;identity&gt;</code>.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="identity" type="t_identity" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="plate" type="t_plate" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="showall" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows every entry without having to search first.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="icon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Icon shown in the box.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="subplate" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the plate to open, when it lives elsewhere in the view.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoclear" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Clears the typed text once an entry has been picked.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="verifymailaddress" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Checks that a typed address is a valid mail address.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="singleselect" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allows only one entry to be picked.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="plateonly" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Offers the plate entries only, refusing anything typed.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="look" type="t_look">
      <xs:annotation>
        <xs:documentation xml:lang="en">Named skin variant.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the box can be interacted with.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_carousel">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Sliding panel carousel. Mark the starting panel with <code>selected="true"</code>. Only <code>&lt;panel&gt;</code> children render — anything else is dropped at runtime.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="panel" type="t_panel" minOccurs="1" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">One slide of the carousel. Mark the starting slide with selected="true".</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="look" type="t_look">
      <xs:annotation>
        <xs:documentation xml:lang="en">Named skin variant.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="duration" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How long one slide takes.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the panel shown first.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_chart">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Draws a chart. Everything but the type comes from the bound data document, whose root carries a <code>&lt;serie&gt;</code> naming what to plot, an optional <code>&lt;axis&gt;</code>, and an <code>&lt;extrusion&gt;</code> marking a pie slice as pulled out.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="charttype" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which chart to draw, for example barchart or pie. Nothing renders without it.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_collapse">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A collapsible plate that shows or hides the components it holds.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:group ref="g_components" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="header" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text of the header that collapses the block.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Set to plate to start open; anything else starts closed.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hcontent" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Height of the content once it is open.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="content-style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS applied to the content block.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="padding" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Padding inside the block.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_colorpicker">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>An OKLCH colour picker bound two-way to a colour node: tone plane, hue strip, hex field, eyedropper, and optional WCAG contrast boundaries. <code>look</code> is accepted but ignored — the picker stays theme-constant so surrounding chrome cannot bias colour perception, and <code>dark</code> is its only appearance axis.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="mode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">popup or inline. Default popup.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The colour, as #rrggbb, #rgb, or a theme colour name.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="color" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The colour, as #rrggbb, #rgb, or a theme colour name.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="contrast" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Backdrop colour to draw the 3:1 and 4.5:1 contrast boundaries against.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="dark" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">auto, true or false. Default auto.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="look" type="t_look">
      <xs:annotation>
        <xs:documentation xml:lang="en">Accepted but deliberately ignored; the picker is theme-constant.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="enabled" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the picker can be interacted with.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_identity">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A plate listing users, friends, contacts or groups, normally inside a <code>&lt;boxlist&gt;</code>. Its content comes from the account and buddy documents.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="header" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Heading shown above the list.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="users" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Includes the users.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="friends" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Includes the friends.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="contacts" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Includes the contacts.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="groups" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Includes the groups.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="multiselect" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Allows more than one entry to be picked.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="showmail" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows the mail address beside each entry.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="showallmail" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows every mail address an entry has, not just the first.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_info">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A rule-driven read-only information block, for use in an expander. Each rule holds the <code>&lt;label&gt;</code> and <code>&lt;data&gt;</code> that make up one line.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="rule" type="t_rule" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="text" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text shown when nothing is bound.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="default" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Value used when the bound data yields nothing.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="colspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Number of columns the block spans in a form layout.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rowspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Number of rows the block spans in a form layout.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-expanded" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Starts fully expanded.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_movie">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Video playback engine, the sibling of <code>&lt;media&gt;</code>. Its <code>&lt;item&gt;</code> children are the playlist.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="item" type="t_item" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">One entry of the playlist.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_progressbar">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A bar showing how far along a task is.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="maxValue" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The value that counts as finished.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="length" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Length of the bar.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the value is shown, for example percent.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="units" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Unit appended to the value.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="aboveLabel" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Label drawn above the bar.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_qr">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Renders a QR code. A <code>&lt;wifi&gt;</code> child encodes a Wi-Fi credential instead of a plain value.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="wifi" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">Encodes a Wi-Fi credential. The component reports "Missing ssid attribute." without ssid.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="ssid" type="xs:string" use="required">
            <xs:annotation>
              <xs:documentation xml:lang="en">Name of the network.</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">What the code encodes.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">What kind of payload the code carries.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hidden" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the code is hidden.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_rating">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A rating control. One <code>&lt;item&gt;</code> per step, each carrying the value that step stands for.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="item" type="t_item" minOccurs="1" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">One step of the rating, carrying its value.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="type" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which rating to draw, for example stars.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="value" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The step selected to begin with.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="unit" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Unit appended to the item values, for example %.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_react">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>Hosts a React component. Nothing mounts without <code>component</code>.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="component" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which React component to mount.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_spinner">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A loading spinner.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="color" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour of the spinner.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="keyframes" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the CSS keyframes driving the animation.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_texteditor">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A plain text editing surface.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="href" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Document to load into the editor.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which syntax the editor works in.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="linenr" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows line numbers.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="set" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which configuration set the editor uses.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="debug" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Turns on the editor debug output.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_veditor">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A 2D flow-chart editor. Each rule holds a <code>&lt;shape&gt;</code> template; the recognised types are connector, decision, gate, operation, process, step, transaction and trigger.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="rule" type="t_rule" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="transformer" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">External transformer that replaces the default transformation of the bound data.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_xmleditor">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>An XML editing surface with line numbers and selection reporting.</p>]]></xs:documentation>
    </xs:annotation>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="mode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Which syntax the editor works in, for example xml.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="linenr" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows line numbers.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="editable" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Whether the document can be edited. Default true.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="updateEnabled" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Writes edits straight through to the bound data document.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selectionmode" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How selections are made and reported.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lstyle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS applied to the label.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="debug" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Turns on the editor debug output.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="t_shape">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A vector primitive, drawn as SVG. <code>type</code> chooses the primitive and the geometry attributes that apply follow from it. A <code>&lt;gradient&gt;</code> child paints it, a <code>&lt;stroke&gt;</code> child outlines it, and a nested <code>&lt;shape&gt;</code> becomes its content.</p><pre><code>&lt;shape name="box" type="rect" x="0" y="0" width="80" height="40" r="6" fill="#08c"/&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="gradient" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">Fills the shape with a gradient. Takes effect only when both color1 and color2 are given.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:attribute name="name" type="xs:string"/>
          <xs:attribute name="type" type="xs:string">
            <xs:annotation><xs:documentation xml:lang="en">Which gradient to paint, for example linear.</xs:documentation></xs:annotation>
          </xs:attribute>
          <xs:attribute name="color1" type="xs:string">
            <xs:annotation><xs:documentation xml:lang="en">Colour the gradient starts at. Required for the gradient to take effect.</xs:documentation></xs:annotation>
          </xs:attribute>
          <xs:attribute name="color2" type="xs:string">
            <xs:annotation><xs:documentation xml:lang="en">Colour the gradient ends at. Required for the gradient to take effect.</xs:documentation></xs:annotation>
          </xs:attribute>
          <xs:attribute name="opac1" type="xs:string">
            <xs:annotation><xs:documentation xml:lang="en">Opacity at the start of the gradient.</xs:documentation></xs:annotation>
          </xs:attribute>
          <xs:attribute name="opac2" type="xs:string">
            <xs:annotation><xs:documentation xml:lang="en">Opacity at the end of the gradient.</xs:documentation></xs:annotation>
          </xs:attribute>
          <xs:attribute name="rotate" type="xs:string">
            <xs:annotation><xs:documentation xml:lang="en">Angle of the gradient. Follows the VML convention, where 0 runs bottom to top.</xs:documentation></xs:annotation>
          </xs:attribute>
          <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="stroke" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">The stroke the shape is outlined with.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="shape" type="t_shape" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">A shape drawn as the content of this one.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="type" type="xs:string">
      <xs:annotation><xs:documentation xml:lang="en">Which primitive to draw: rect (the default), line, arc, curve, path and so on.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="x" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Left edge of the shape.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="y" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Top edge of the shape.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="x1" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Start of a line or curve, horizontally.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="y1" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Start of a line or curve, vertically.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="x2" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">End of a line or curve, horizontally.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="y2" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">End of a line or curve, vertically.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="r" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Corner radius, or the radius of an arc.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="startangle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Angle an arc starts at.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="endangle" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Angle an arc ends at.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cp1x" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">First control point of a curve, horizontally.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cp1y" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">First control point of a curve, vertically.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cp2x" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Second control point of a curve, horizontally.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="cp2y" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Second control point of a curve, vertically.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="points" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The points of a path, written as "x1,y1 x2,y2 …".</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="autoclose" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Closes the path back to its first point.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fill" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour the shape is filled with.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="fillopac" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Opacity of the fill. Default 100%.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="stroke" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Colour the shape is outlined with.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeopac" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Opacity of the outline.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="strokeweight" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Thickness of the outline.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineWidth" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Width of the line.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineCap" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How the line ends. Default butt.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="lineJoin" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How two lines meet. Default miter.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="miterLimit" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">How far a miter join may extend before it is cut off.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="alpha" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Overall opacity of the shape.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="arrowend" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Draws an arrow head at the end of the line.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rotate" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Angle the shape is rotated by.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="innerleft" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Left offset of the shape content.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="innertop" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Top offset of the shape content.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Backing type for an undocumented component whose children are its own
       markup rather than nested components. Both content and attributes are
       open, so nothing inside it is reported as an error while it stays
       undocumented. -->
  <xs:complexType name="t_openMarkupComponent" mixed="true">
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- Backing type for a component the schema knows exists but cannot describe:
       it nests components like a panel and takes attributes the reference does
       not list. Deliberately open, so a real component is not reported as an
       error while it stays undocumented. -->
  <xs:complexType name="t_openComponent" mixed="true">
    <xs:sequence>
      <xs:group ref="g_components" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <!-- href names the view this component loads: host://service/chatbot.xml.
         Declared rather than left to a wildcard, because XSD intersects the
         wildcards a type inherits — an ##any here and the narrower one on
         t_inlineComponent come out as the narrow one, so an unqualified
         attribute has to be named explicitly to be allowed. -->
    <xs:attribute name="href" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The view this component loads.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearance using CSS</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
</xs:schema>
