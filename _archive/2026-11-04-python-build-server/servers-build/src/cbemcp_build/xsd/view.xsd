  <xs:attributeGroup name="t_inlineComponent">
    <!-- FIXME: collaborator, look -->
    <!-- Production markup reported this rejected on label, input and checkbox.
         It is a binding expression rather than anything specific to those three,
         so it belongs to the set every component shares. Typed as a string, not
         a stricter type: the value is frequently a {$variable} reference. -->
    <xs:attribute name="select" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">XPath selecting the node this component binds to, relative to its data.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <xs:attribute name="name" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Name of the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <xs:attribute name="class" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">CSS class name(s) to apply to the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <!-- draggable is handled in GUI_View.dragStart -->
    <xs:attribute name="draggable" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If parts of the component should be draggable to other components.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <!-- dragicon is handled in GUI_View.dragMove -->
    <xs:attribute name="dragicon" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Path to an icon to use as drag handle for an item, or "true" for components that can generate/look up icons.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <xs:attribute name="height" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The height of the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <xs:attribute name="hide" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Decides if the component should be hidden when initially loaded.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <!-- label is handled by the panel component. -->
    <xs:attribute name="label" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Text label above the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <xs:attribute ref="l:label"/>

    <xs:attribute name="label-style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Override the text label with additional CSS styling.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <!-- tabindex is handled in GUI_View.build#callInit -->
    <xs:attribute name="tabindex" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>

    <!-- theme is handled in SYS_ThemeManager.applyTheme -->
    <xs:attribute name="theme" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Set the theme for the current component and its children.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <xs:attribute name="width" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">The width of the component.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <!-- windowdrag is handled in GUI_View.dragStart -->
    <xs:attribute name="windowdrag" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">If the application window should be dragged when the component is dragged.</xs:documentation>
      </xs:annotation>
    </xs:attribute>

    <!-- Any localized twin (l:text, l:title, l:icon, …). lax so the ones declared
         in lang.xsd are still validated and offered, while a twin for an attribute
         nobody has declared yet is accepted rather than reported. Declaring these
         one type at a time was a standing source of false errors. -->
    <xs:anyAttribute namespace="https://xios3.com/lang http://xios3.com/lang http://www.w3.org/1999/xlink" processContents="lax"/>
  </xs:attributeGroup>

  <!-- A component added by the project rather than built in: declared either in
       the application's <components> block or in an index.html
       <script type="xios" name="addConfig">, and implemented in JavaScript
       and/or XSL. Its attributes and children are its own API, so both are left
       open — the schema cannot know them. -->
  <xs:complexType name="t_customComponent" mixed="true">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>A component contributed by this project. Declared with a tag name in the application's <code>&lt;components&gt;</code> block, or in an <code>index.html</code> <code>&lt;script type="xios" name="addConfig"&gt;</code>, and implemented in JavaScript and/or XSL. Its attributes are defined by that implementation, so they are accepted as written.</p><pre><code>&lt;script type="xios" name="addConfig"&gt;<br/>&#32;&#32;&lt;component name="Spinner" tag="spinner"&gt;<br/>&#32;&#32;&#32;&#32;&lt;skin href="xios/ui/Spinner/spinner.xsl"/&gt;<br/>&#32;&#32;&lt;/component&gt;<br/>&lt;/script&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:any namespace="##any" processContents="skip" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- Custom component group. Empty here, because a wildcard alongside the named
       components below violates XSD 1.0's Unique Particle Attribution rule and
       stops the whole schema compiling. The extension redefines this group with
       one element per custom tag it finds declared in the workspace — see
       src/xml/customSchema.ts. -->
  <xs:group name="g_custom"><xs:sequence/></xs:group>

  <!-- Shared set of all UI components, so containers/rules accept (and complete) any component. -->
  <xs:group name="g_components">
    <xs:choice>
      <xs:group ref="g_custom" minOccurs="0" />
      <!-- A component the reference does not document but the runtime provides,
           found in production views. Its attributes are the shared set plus
           whatever it takes, so they are left open rather than guessed at. -->
      <xs:element name="app" type="t_openComponent" minOccurs="0" maxOccurs="unbounded" />
      <!-- Undocumented like app, but each takes attributes and children of its
           own (widgetpane takes rules, plotly a layout), so both are left open
           rather than guessed at. -->
      <xs:element name="chatrender" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="filepicker" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="pipeline" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="plotly" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="widgetpane" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="accordion" type="t_accordion" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="action" type="t_action" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="boxlist" type="t_boxlist" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="carousel" type="t_carousel" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="chart" type="t_chart" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="collapse" type="t_collapse" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="colorpicker" type="t_colorpicker" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="identity" type="t_identity" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="info" type="t_info" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="movie" type="t_movie" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="progressbar" type="t_progressbar" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="qr" type="t_qr" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="rating" type="t_rating" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="react" type="t_react" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="shape" type="t_shape" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="spinner" type="t_spinner" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="texteditor" type="t_texteditor" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="veditor" type="t_veditor" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="xmleditor" type="t_xmleditor" minOccurs="0" maxOccurs="unbounded" />
      <!-- Components the reference lists with no authored documentation: what they
           take was read out of the skin and the implementation, so both attributes
           and children are left open rather than half-guessed. -->
      <xs:element name="appdesigner" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="audiocontroller" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="canvas" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="colorgradient" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="colorswatches" type="t_openMarkupComponent" minOccurs="0" maxOccurs="unbounded" />
