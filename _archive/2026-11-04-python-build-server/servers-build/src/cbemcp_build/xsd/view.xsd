      <xs:documentation xml:lang="en"><![CDATA[<p>The root component which holds all properties for the window and contains all other components.</p><pre><code>&lt;view name="basicView" title="Basic" icon="icon://flower"&gt;<br/>&#32;&#32;&lt;panel bgcolor="grey" padding="10"&gt;<br/>&#32;&#32;&#32;&#32;&lt;label text="Basic View" size="16"/&gt;<br/>&#32;&#32;&lt;/panel&gt;<br/>&lt;/view&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <!-- One repeating choice rather than a chrome-then-panel sequence: a view
         holds several panels — the body plus any it positions along an edge —
         and the chrome is written both before and after them. -->
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="panel" type="t_panel" minOccurs="0" maxOccurs="unbounded">
