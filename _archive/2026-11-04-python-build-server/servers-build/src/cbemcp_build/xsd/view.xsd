    <xs:attribute name="weight" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Thickness of the hour and minute hands.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="secweight" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Thickness of the second hand.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="length" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Length of the hands.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <xs:complexType name="t_clock">
    <xs:annotation>
      <xs:documentation xml:lang="en"><![CDATA[<p>The component creates a graphical clock showing time, date, namesday and a monthly calender</p><pre><code>&lt;clock name="clockAnalog" mode="analog" height="135" width="135"&gt;<br/>&#32;&#32;&lt;style href="xios/ui/Clock/ClockAqua1.png" length="2" weight="2pt" secweight="1pt" hour="#000" min="#000" sec="#000"/&gt;<br/>&lt;/clock&gt;</code></pre>]]></xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="city" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
              <xs:documentation xml:lang="en">Name of the component</xs:documentation>
            </xs:annotation>
          </xs:attribute>
          <xs:attribute name="diff" type="xs:string" use="required" />
        </xs:complexType>
      </xs:element>
      <xs:element name="style" type="t_clock_style" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation xml:lang="en">Configures the hands and face of an analog clock. Required when mode is analog.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="rule" type="t_rule" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attributeGroup ref="t_inlineComponent"/>
    <xs:attribute name="calendar" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows a monthly calendar if set to true</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="calendars" type="xs:int">
      <xs:annotation>
        <xs:documentation xml:lang="en">Specifies how many calendar months to show if calendar is set to true (default is 1)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="colspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="date" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows todays date if set to true</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="hour" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="href" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Changes the default renderer for displaying a calendar (optional)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="min" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="mode" type="t_clockMode">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows an analog clock if set to 'analog', otherwise the time is shown in digital format</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="namesday" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows todays namesday if set to true</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="rowspan" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="sec" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="selectdate" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Enable selection of dates by clicking on calendar</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="shared" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Defines if it should share the global system calendar instead of creating a new instance</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="skin" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Edits the appearence by style code</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="summer" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Compensate for summer time?</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tree-expanded" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en" />
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="worldtime" type="t_flag">
      <xs:annotation>
        <xs:documentation xml:lang="en">Shows a worldclock</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="xyscale" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">scales the clock (percent)</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="title" type="xs:string">
      <xs:annotation>
        <xs:documentation xml:lang="en">Tool-tip text.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <!-- The l: localisation twins and the xlink attributes components carry for
         composition (xlink:href pulls in another view); both spellings of the
