{
  "servers": {
    "cloudbackend-docs": {
      "type": "stdio",
      "command": "node",
      "args": [
        "<plugin-dir>/servers/docs/index.mjs"
      ]
    },
    "cloudbackend-build": {
      "type": "stdio",
      "command": "<plugin-dir>/.data/venv/bin/python",
      "args": [
        "-m",
        "cbemcp_build"
      ],
      "env": {
        "PYTHONPATH": "<plugin-dir>/servers/build/src"
      }
    }
  }
}
