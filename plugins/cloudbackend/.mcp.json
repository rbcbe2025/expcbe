{
  "mcpServers": {
    "cloudbackend-docs": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/docs/index.mjs"
      ]
    },
    "cloudbackend-build": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/build/index.mjs"
      ]
    },
    "cloudbackend-deploy": {
      "type": "http",
      "url": "https://mcp.cloudbackend.com/mcp/${user_config.cbe_tenant}"
    }
  }
}
