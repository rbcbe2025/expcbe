{
  "mcpServers": {
    "cloudbackend-docs": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/docs/index.mjs"
      ]
    },
    "cloudbackend-build": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/build/index.mjs"
      ]
    },
    "cloudbackend-tenant": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/servers/tenant/index.mjs"
      ],
      "env": {
        "CBE_SESSION_DIR": "${CLAUDE_PLUGIN_DATA}/sessions"
      }
    }
  }
}
