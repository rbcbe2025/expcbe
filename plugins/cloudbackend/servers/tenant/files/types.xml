      <message user="{#Profile#/profile/username}" text="submit" name="{$user_alias}" date="{$date}" time="{$time}" tstp="{$tm}" lang="{#Profile#/profile/locale}">
        {#CreateTicket#descriptionText}
      </message>
    </ticket>
  </template>
