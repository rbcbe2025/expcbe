  <index>
    <key name="section" xpath="/ticket/@section"/>
    <key name="subsect" xpath="/ticket/@subsect"/>
    <key name="desc" xpath="/ticket/@description"/>
    <key name="assigned" xpath="/ticket/@assigned"/>
    <key name="severity" xpath="/ticket/@severity"/>
    <key name="status" xpath="/ticket/@status"/>
    <key name="replyto" xpath="/ticket/@replyto"/>
    <key name="tenantName" xpath="/ticket/@tenantName"/>
    <key name="messuser" xpath="/ticket/message/@user"/>
  </index>
  <search>@name</search>
  <list folders="true" height="default" button="detail" sort="ascending" match="@name">
    <h1 xpath="@name"/>
  </list>
  <template>
    <ticket tenantName="{$tenantName}" assigned="Pending" email="{#Profile#/profile/email}" firstname="{#Profile#/profile/firstname}" lastname="{#Profile#/profile/lastname}" lastlogin="{#Profile#/profile/lastlogin}" logins="{#Profile#/profile/logins}" section="{#CreateTicket#comboSection}" subsect="{$subSectionName}" severity="{#CreateTicket#severityFeedback}" status="New" replyto="{#CreateTicket#myEmail}" description="{#CreateTicket#short_description}">
