# Build outputs: the marketplace, index and zip the portal serves are produced per release by scripts/gen-clients.mjs
# and scripts/pack.mjs, then copied into the hub's public/public/plugin/. On disk, not in history.
dist/

# Eval runs (claude plugin eval --json, and the index and gradings eval-report.mjs keeps) are records of a run, not
# source. The stored without-plugin baselines and reference transcripts (evals/baselines/) are source and stay tracked.
evals/results/

# Nothing is installed here (zero dependencies), so this is a guard against a stray npm install.
node_modules/

# OS and editor noise
.DS_Store
._*

# Machine-local Claude Code state
.claude/settings.local.json
**/.claude/worktrees/
