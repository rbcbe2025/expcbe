<?xml version="1.0" encoding="UTF-8"?>
<!-- Planboard: the first version. One kind of record (projects) in one container, a list with search
     and an empty state, a detail with the fields to edit, New / Save / Delete, a status line, and a
     phone layout. The look is a token theme: seeds (colours) and knobs (type, spacing, shape) below;
     the runtime derives hovers, borders and selection from them, so no view names a colour.

     Advanced packaging: views/ (one per screen size), processes/, xsl/, styles/, ui/ (the design kit's
     two components), data/ (sample records to try the app without a tenant).
     Generated from the xios3-app-design skill's example by designkit.py app. -->
<application xmlns:xlink="http://www.w3.org/1999/xlink" name="planboard" icon="icon://clipboard-check?look=lucide&amp;color=4338ca" instances="1">
  <settings/>
  <about version="1.0"><description>Planboard</description></about>

  <!-- The look of Planboard: a token theme. Seeds are the colours, knobs the type, spacing and shape;
       the runtime derives hovers, borders, selection tints and muted text from the seeds, so the
       view never names a colour. icon="lucide" selects the Lucide icon collection the runtime ships
       (references/icons.md). Every component is look="token", and the view component loads the kit's
       ui/DesignKit/theme.css, which styles every component from these values (Apple's principles on a
       Tailwind-like scale; references/theme.md). Direction: studio (bright, confident, warm). Generated by designkit.py. -->
  <theme name="planboard" tokens="true" icon="lucide" dialogShadow="false">
    <tokens>
      <font-sans>-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif</font-sans>
      <font-display>'Avenir Next', -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif</font-display>
      <font-mono>ui-monospace, 'SF Mono', Menlo, Consolas, monospace</font-mono>
      <text-xs>11px</text-xs>
      <text-sm>13px</text-sm>
      <text-md>15px</text-md>
      <text-lg>17px</text-lg>
      <text-xl>22px</text-xl>
      <weight-normal>400</weight-normal>
      <weight-medium>500</weight-medium>
      <weight-bold>600</weight-bold>
      <leading-tight>1.2</leading-tight>
      <leading-normal>1.45</leading-normal>
      <leading-body>1.55</leading-body>
      <tracking-label>0.06em</tracking-label>
      <space-1>2px</space-1>
      <space-2>4px</space-2>
      <space-3>8px</space-3>
      <space-4>12px</space-4>
      <space-5>16px</space-5>
      <space-6>24px</space-6>
      <control-height>40px</control-height>
      <control-pad-x>14px</control-pad-x>
      <control-gap>8px</control-gap>
      <radius-sm>8px</radius-sm>
      <radius-md>12px</radius-md>
      <radius-lg>16px</radius-lg>
    </tokens>
    <components>
      <view look="token"><style href="ui/DesignKit/theme.css"/></view>
      <accordion look="token"/>
      <boxlist look="token"/>
      <breadcrumbs look="token"/>
      <bush look="token"/>
      <button look="token"/>
      <calendar look="token"/>
      <checkbox look="token"/>
      <codeeditor look="token"/>
      <collapse look="token"/>
      <color look="token"/>
      <combobox look="token"/>
      <date look="token"/>
      <filelist look="token"/>
      <grid look="token"/>
      <group look="token"/>
      <identity look="token"/>
      <iconlist look="token"/>
      <input look="token"/>
      <label look="token"/>
      <listview look="token"/>
      <menu look="token"/>
      <menubar look="token"/>
      <panel look="token"/>
      <radio look="token"/>
      <shell look="token"/>
      <slider look="token"/>
      <tabstrip look="token"/>
      <textarea look="token"/>
      <toggle look="token"/>
      <toolbar look="token"/>
      <tree look="token"/>
      <upload look="token"/>
    </components>
    <colors>
      <color name="primary">#4338ca</color>
      <color name="on-primary">#ffffff</color>
      <color name="secondary">#c2410c</color>
      <color name="on-secondary">#ffffff</color>
      <color name="tertiary">#0e7490</color>
      <color name="on-tertiary">#ffffff</color>
      <color name="background">#f4f4fb</color>
      <color name="surface">#ffffff</color>
      <color name="on-surface">#1e1b4b</color>
      <color name="error">#b91c1c</color>
      <color name="on-error">#ffffff</color>
      <color name="lightIcon">#ffffff</color>
      <color name="darkIcon">#4338ca</color>
      <color name="grey">#6b7280</color>
    </colors>
    <spinner><svg xmlns="http://www.w3.org/2000/svg" class="circular" viewBox="25 25 50 50" stroke="#6b7280"><style>@keyframes dash{0%{stroke-dasharray:1,200;stroke-dashoffset:0}50%{stroke-dasharray:89,200;stroke-dashoffset:-35}100%{stroke-dasharray:89,200;stroke-dashoffset:-124}}@keyframes rotate{100%{transform:rotate(360deg)}}.circular{animation:rotate 2s linear infinite;transform-origin:center center}.path{stroke-dasharray:1,200;stroke-dashoffset:0;animation:dash 1.5s ease-in-out infinite;stroke-linecap:round}</style><circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="2" stroke-miterlimit="10"/></svg></spinner>
  </theme>

  <!-- The login screen: the runtime's own login application, the CloudBackend PaaS sign-in's shape (the logo above
       a white card, the fields, one full-width button) with all three ways in: sign in, sign up (create) and
       forgot password (reset). Keep create and reset: without them their links do not show. session="true"
       keeps the sign-in across reloads (the runtime stores the session in the browser for 7 days of use; Sign out
       ends it).
       Generated by designkit.py; references/login.md. -->
  <login>
    <background dark="true">login-bg.svg</background>
    <logo>logo.svg</logo>
    <title>Log in</title>
    <description>Welcome back. Log in to Planboard.</description>
    <button>Log in</button>
    <buttonColor>#4338ca</buttonColor>
    <linkColor>#4338ca</linkColor>
    <reset>Forgot your password?</reset>
    <createPrompt>Don't have an account?</createPrompt>
    <create>Create an account</create>
    <copyright>Copyright &#169; 2026 Planboard</copyright>
  </login>

  <components>
    <component name="Screen" tag="screen" class="CA_Screen" href="ui/DesignKit/CA_Screen.js" container="false">
      <skin href="ui/DesignKit/screen.xsl"/>
    </component>
    <component name="Status" tag="statusline" class="CA_Status" href="ui/DesignKit/CA_Status.js" container="false">
      <skin href="ui/DesignKit/status.xsl"/>
    </component>
  </components>

  <!-- Two layouts, one name: the runtime renders the first view whose screen= media query is true,
       so the process addresses "App" whichever file is on screen. -->
  <view name="App" screen="(min-width: 601px)" xlink:actuate="onRequest" xlink:href="views/app.xml"/>
  <view name="App" screen="phone" xlink:actuate="onRequest" xlink:href="views/app-phone.xml"/>
  <!-- the login application first; after sign-in it opens the first view and the app process -->
  <process xlink:actuate="onLoad" xlink:href="xios://apps/login.xml"/>
  <process xlink:actuate="onRequest" xlink:href="processes/app.xml"/>
</application>
