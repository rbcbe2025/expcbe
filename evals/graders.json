{
  "about": "How gen-evals.mjs grades an assertion other than with the judge over the trace, keyed by the assertion's text in the skills' evals.json (so a case can be renumbered or moved without losing it). checks.json (tool calls) is read first. Then: `drop` (the assertion is not graded; each with its reason), `regex` (a free regex grader: `source: backtest` entries come from scripts/regex-backtest.mjs --write, which proved them against every recorded run; `source: hand` entries are written here, each with its reason), `file_exists` (a free check that the run created the file), `focus` (the judge looks at this target instead of the trace: the trace shows the judge only the first and last 12 messages, so a file written in the middle of a run is invisible to it, and a point the final reply carries is cheaper to judge there).",
  "drop": {
    "Does not re-ask what the prompt already gave (the tenant, the idea)": "passed in every recorded run with and without the plugin; 'Asks at most one round of three or fewer questions' carries the behaviour",
    "Does not suggest a data: URL or the configurator's folder pick as the fix": "passed in every recorded run with and without the plugin",
    "Does not ask about prices, a domain, an e-mail provider or a logo at this point": "passed in every recorded run with and without the plugin; the question limit carries the behaviour",
    "Names what the docs leave open": "passed in every recorded run with and without the plugin: the model says it on its own",
    "No invented layout attribute dock=": "passed in every recorded run with and without the plugin",
    "Does not suggest writing from JavaScript": "passed in every recorded run with and without the plugin; the cases that ask about persistence carry the behaviour"
  },
  "regex": {
    "Logs in with POST /login using HTTP Basic credentials": {
      "source": "backtest",
      "pattern": "(?<![\\s\\S])(?=[\\s\\S]*?(?:/login\\b))(?=[\\s\\S]*?(?:basic|b64encode|base64))",
      "flags": "im",
      "target": "last_message",
      "match": "contains",
      "backtest": {
        "runs": 6,
        "pass": 3,
        "case": "cloudbackend-rest-api-1",
        "n": 1
      }
    },
    "Extracts the session token and sends 'Authorization: WRAP access_token=' on later calls": {
      "source": "backtest",
      "pattern": "(?<![\\s\\S])(?=[\\s\\S]*?(?:WRAP access_token=))",
      "flags": "im",
      "target": "last_message",
      "match": "contains",
      "backtest": {
        "runs": 6,
        "pass": 3,
        "case": "cloudbackend-rest-api-1",
        "n": 3
      }
    },
    "Does not use the requests library": {
      "source": "hand",
      "why": "passed in every recorded run with and without the plugin; the code is in a written file, so the final message is no target, and the skill text never says 'import requests', so the trace is a safe one",
      "pattern": "import requests|from requests import",
      "flags": "",
      "target": "trace",
      "match": "not_contains"
    },
